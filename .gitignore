# secrets — .env.example is the contract and IS committed
.env
.env.*
!.env.example

# raw source data (human-verified sheet, HTS PDFs) — never committed; data/rates is generated from it
data/source/
# Office lock files (e.g. ~$sheet.xlsx while the workbook is open)
~$*

# deps / build
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# test output
coverage/
playwright-report/
test-results/

# misc
*.log
.claude/hooks/protect-rates.log
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
