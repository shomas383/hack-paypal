{
  "name": "landed",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "rates:import": "tsx scripts/import-verify-sheet.ts",
    "rates:validate": "tsx scripts/validate-rates.ts",
    "hts:import": "tsx scripts/import-hts.ts",
    "eval:classifier": "tsx scripts/eval-classifier.ts",
    "agent:live": "tsx scripts/agent-live-run.ts",
    "spike:paypal": "tsx --env-file=.env scripts/spike/run.ts",
    "spike:a": "tsx --env-file=.env scripts/spike/run.ts a",
    "spike:b": "tsx --env-file=.env scripts/spike/run.ts b",
    "spike:c": "tsx --env-file=.env scripts/spike/run.ts c",
    "spike:d": "tsx --env-file=.env scripts/spike/run.ts d"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@paypal/agent-toolkit": "1.11.0",
    "@paypal/paypal-js": "11.2.1",
    "ai": "7.0.127",
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
