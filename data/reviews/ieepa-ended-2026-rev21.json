 "sources": [
  {
   "title": "Executive Order 14389, Ending Certain Tariff Actions",
   "citation": "91 FR 9437 (Feb 25, 2026), §1 and §2(d)",
   "urls": [
    "https://www.federalregister.gov/documents/2026/02/25/2026-03832/ending-certain-tariff-actions",
    "https://www.whitehouse.gov/presidential-actions/2026/02/ending-certain-tariff-actions/"
   ],
   "read_on": "2026-10-11",
   "says": "§1 ends the IEEPA duties under EOs 14193, 14194, 14195 (each as amended), 14245, 14257 (as amended), 14323 (as amended), 14329 (as amended), 14380 and 14382; §2(d): Section 232 and 301 duties unaffected; HTSUS changes by later notice."
  },
  {
   "title": "CBP CSMS # 67834313, Ending Collection of International Emergency Economic Powers Act Duties",
   "citation": "sent 2026-02-22",
   "urls": [
    "https://content.govdelivery.com/accounts/USDHSCBP/bulletins/40b11c9"
   ],
   "read_on": "2026-10-11",
   "says": "IEEPA duties not collected for goods entered on or after 12:00 a.m. ET Feb 24, 2026; affects IEEPA duties only."
  },
  {
   "title": "Executive Order 14326, Further Modifying the Reciprocal Tariff Rates",
   "citation": "90 FR 37963",
   "urls": [
    "https://www.govinfo.gov/content/pkg/FR-2025-08-06/pdf/2025-15010.pdf"
   ],
   "read_on": "2026-10-11",
   "says": "Amends EO 14257; cited by 9903.02.01, so covered by \"14257 (as amended)\"."
  }
 ],
 "docs_quote": {
  "file": "docs/SPEC.md",
  "quote": "IEEPA tariffs (9903.01.xx / 9903.02.xx) are still printed in Chapter 99 but terminated (CBP stopped collecting for entries on/after Feb 24, 2026) — never add them."
 },
