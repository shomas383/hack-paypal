# Sandbox only. Copy to .env (gitignored). Never commit real values.
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox personal (buyer) account email — invoice recipient in spike (b)
PAYPAL_SANDBOX_BUYER_EMAIL=
# Sandbox Personal buyer password — e2e only (pnpm test:e2e). Never logged; e2e traces/screenshots are off.
# Leave empty to log into the PayPal popup by hand (the test pauses headed).
PAYPAL_SANDBOX_BUYER_PASSWORD=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
ANTHROPIC_API_KEY=
DATABASE_URL=postgres://landed:landed@localhost:5432/landed
# Public https origin for absolute URLs (never derived from the request). Required when NODE_ENV=production
# (Render, or a local `pnpm start`); leave empty for `pnpm dev`.
PUBLIC_BASE_URL=
SPEND_CAP_PER_ORDER_USD_MINOR=40000
SPEND_CAP_PER_SESSION_USD_MINOR=80000
QUOTE_TTL_SECONDS=900
CLASSIFIER_REVIEW_THRESHOLD=0.80
# Classifier call budget, checked before any LLM call (defaults if unset: 10 / 20 / 200)
CLASSIFIER_LIMIT_PER_SESSION_PER_HOUR=10
CLASSIFIER_LIMIT_PER_IP_PER_HOUR=20
CLASSIFIER_DAILY_CEILING=200
# Buyer-agent runs, checked before the first model call (IP limit = 2x the session limit; defaults 5 / 30)
AGENT_LIMIT_PER_SESSION_PER_HOUR=5
AGENT_DAILY_CEILING=30
# Public /estimate budget (each estimate = 2 classifier model calls; identical descriptions within 24 h reuse the result).
ESTIMATE_LIMIT_PER_SESSION_PER_HOUR=5
ESTIMATE_LIMIT_PER_IP_PER_HOUR=10
ESTIMATE_DAILY_CEILING=100
# Seller console passcode (/seller), at least 12 characters. Leave empty to disable the console (404).
SELLER_CONSOLE_PASSCODE=
# 1 = public read-only seller view at /seller/demo (review queue + ledger; no writes, no passcode). Empty or 0 = off (404).
SELLER_PUBLIC_VIEW=
# X-Forwarded-For entries added by trusted proxies, skipped from the right to find the client IP (Render: 1; default 1)
TRUSTED_PROXY_HOPS=1